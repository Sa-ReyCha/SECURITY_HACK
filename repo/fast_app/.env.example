# ─────────────────────────────────────────────────────────────────────────────
# fast_app/.env — FastAPI application settings
# Copy to fast_app/.env and fill in the values below.
#   cp fast_app/.env.example fast_app/.env
#
# This file is mounted read-only into the container at /app/.env
# (see volumes section in podman-compose.yml / docker-compose.yml).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core API settings ─────────────────────────────────────────────────────────

# Rows returned per page (server-side batch size)
# BATCH_SIZE=500

# Path to the JSON file mapping bearer tokens → team names
# API_KEYS_PATH=api_keys.json

# Path to the access-log CSV (relative to /app inside the container)
# ACCESS_LOG_PATH=output/access_logs.csv

# Max authenticated requests per 30-minute window per API key (0 = disabled)
# MAX_REQUESTS_PER_WINDOW=220

# Minutes to block a key after it exceeds the limit (0 = window-reset behaviour)
# BLOCK_DURATION_MINUTES=10

# Path to the main logs CSV produced by generate_synthetic_data.py
# CSV_PATH=output/logs.csv

# ── OpenSearch integration ────────────────────────────────────────────────────
# Leave OPENSEARCH_HOST empty (or unset) to disable OpenSearch indexing entirely.

# Full URL of the OpenSearch endpoint
OPENSEARCH_HOST=https://opensearch.993212.xyz

# HTTP basic-auth credentials
OPENSEARCH_USER=your_opensearch_username
OPENSEARCH_PASSWORD=your_opensearch_password

# Index name where access-log documents are written
OPENSEARCH_INDEX=access_logs

# Number of retry attempts before falling back to CSV (exponential back-off)
OPENSEARCH_MAX_RETRIES=3

# Base delay in seconds for exponential back-off between retries
# Actual delays: 1s, 2s, 4s, … (base * 2^attempt)
OPENSEARCH_RETRY_DELAY_S=1.0

# Fallback CSV path — records that could not be indexed after all retries
# are appended here so no data is silently lost.
OPENSEARCH_FALLBACK_CSV=output/opensearch_failed.csv