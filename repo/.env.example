# ─────────────────────────────────────────────────────────────────────────────
# Root .env — used by docker-compose.yml only
# Copy to .env and fill in the values below.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Cloudflare Tunnel token (primary).
# Get it from: Cloudflare Dashboard → Zero Trust → Networks → Tunnels → (your tunnel) → Configure → Token
TUNNEL_TOKEN=paste_your_cloudflare_tunnel_token_here

# Cloudflare Tunnel token (secondary — optional, for a second independent tunnel + URL).
# Steps to create:
#   1. Cloudflare Dashboard → Zero Trust → Networks → Tunnels → Create a tunnel
#   2. Name it (e.g. "soc-api-2"), choose Cloudflared connector
#   3. Copy the token shown and paste it below
#   4. In the tunnel's Public Hostname tab, add a route → your new subdomain → http://localhost:8000
TUNNEL_TOKEN_2=paste_your_second_cloudflare_tunnel_token_here

# Cloudflare Tunnel token (3)
TUNNEL_TOKEN_3=paste_your_third_cloudflare_tunnel_token_here

# Cloudflare Tunnel token (4)
TUNNEL_TOKEN_4=paste_your_fourth_cloudflare_tunnel_token_here

# Cloudflare Tunnel token (5)
TUNNEL_TOKEN_5=paste_your_fifth_cloudflare_tunnel_token_here
