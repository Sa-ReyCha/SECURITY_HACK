# ─────────────────────────────────────────────────────────────────────────────
# Root .env — used by docker-compose.yml only
# Copy to .env and fill in the values below.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Cloudflare Tunnel token.
# Get it from: Cloudflare Dashboard → Zero Trust → Networks → Tunnels → (your tunnel) → Configure → Token
TUNNEL_TOKEN=paste_your_cloudflare_tunnel_token_here